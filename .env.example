# WebDesignAgents 환경변수 견본 — 복사해서 .env 로 사용
WDA_PERSONAS_ROOT=personas
WDA_DATA_DIR=data

# LLM (경로 B) — HWAXPortal env-kits 상속 (@FROM_RA 마커로 채워짐, dev 는 로컬 vLLM)
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=qwen2.5-7b-dev
LLM_API_KEY=EMPTY
LLM_DISABLE_STREAMING=1
NO_PROXY=10.198.143.137,127.0.0.1,localhost

# TTS — VoiceRecorder (개발: 직결 / HEAXHub 연방 후: http://127.0.0.1:4180/apps/voice_recorder + PAT)
WDA_TTS_BASE_URL=http://localhost:8177
WDA_TTS_PAT=

# 민감 보고서를 경로 B(폐쇄망 vLLM) 전용으로 강제
WDA_LOCAL_ONLY=0
