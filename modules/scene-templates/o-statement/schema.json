{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wda:tpl.o-statement/schema@1.0.0",
  "title": "tpl.o-statement 데이터 스키마 — 선언형 오프닝(문장 하나가 화면을 채운다)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lines"
  ],
  "properties": {
    "lines": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "description": "선언 문장 2~3행. 행 자수 상한 18자는 폰트 하한 96px 의 역산 — 1720px ÷ (18자 × 0.99em) = 96px",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 18,
            "x-read": true,
            "description": "한 행 전체 문장 (18자 = 96px 기준 1행 실측 상한)"
          },
          "accent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12,
            "description": "text 안의 강조 부분 문자열 — 색만 다르고 굵기는 같다. text 에 없으면 강조 없음"
          }
        }
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30,
      "description": "문장이 완성된 뒤 아래에 조용히 등장하는 출처 한 줄 (앞에 — 이 자동으로 붙는다)"
    }
  }
}
