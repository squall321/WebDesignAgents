{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wda:tpl.l-list/schema@1.0.0",
  "title": "tpl.l-list 데이터 스키마",
  "description": "목록형 상세 5~8행 — process(6칸 그리드)·proof(3열 카드)가 못 담는 '많은 항목을 읽히게' 담당. 행마다 [번호/아이콘] + 제목 + 설명(+상태 칩). 행 수가 늘면 세로 예산(콘텐츠 대역 330~955px = 625px)이 줄어들므로 스키마가 설명 길이를 조인다 — 6행 이상이면 설명 1행. 최소 폰트 24px 은 어느 경우에도 지킨다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kicker",
    "title",
    "rows"
  ],
  "properties": {
    "kicker": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 26,
      "x-read": true,
      "description": "타이틀 1행 — 내용 폭 1640px ÷ 56px(sectionTitle) ≈ 29자, 안전 26자"
    },
    "rows": {
      "type": "array",
      "minItems": 5,
      "maxItems": 8,
      "description": "목록 행 5~8. 8행일 때 행 높이 74px = 제목 32px + 설명 29px + 여백 — 9행 이상은 최소 폰트를 깨므로 거부한다(추리기는 심의 몫)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title"
        ],
        "properties": {
          "num": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2,
            "description": "배지 번호 — 미지정 시 렌더가 1부터 매긴다. 56×56 배지 안 27px 기준 2자"
          },
          "icon": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2,
            "description": "번호 대신 쓰는 기호/이니셜 (num 보다 우선)"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "description": "행 제목 1행 — 텍스트 폭 1316px ÷ 31px(item) ≈ 42자, 안전 30자"
          },
          "desc": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "설명 — 1316px ÷ 24px(caption) ≈ 54자/행. 5행짜리 목록에서만 2행(100자)까지 허용하고, 6행 이상은 아래 allOf 가 50자(1행)로 조인다"
          },
          "chip": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "description": "우측 상태 칩 — 폭 180px 예약",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 6,
                "description": "24px × 6자 + 패딩 36px = 180px (nowrap)"
              },
              "tone": {
                "enum": [
                  "info",
                  "success",
                  "caution",
                  "active"
                ]
              }
            }
          }
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "description": "프레임 푸터 메타 — 없으면 푸터 숨김",
      "properties": {
        "brand": {
          "type": "string",
          "maxLength": 24
        },
        "idx": {
          "type": "string",
          "maxLength": 4
        },
        "total": {
          "type": "string",
          "maxLength": 4
        }
      }
    }
  },
  "allOf": [
    {
      "description": "밀도 조임 — 6행 이상이면 행 높이가 100px 이하로 내려가 설명은 1행만 들어간다",
      "if": {
        "properties": {
          "rows": {
            "minItems": 6
          }
        },
        "required": [
          "rows"
        ]
      },
      "then": {
        "properties": {
          "rows": {
            "items": {
              "properties": {
                "desc": {
                  "maxLength": 50
                }
              }
            }
          }
        }
      }
    }
  ]
}
